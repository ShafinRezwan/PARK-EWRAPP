generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CONTRACTS
  SUPERINTENDENT
  ACCOUNTING
  PROJECT_MANAGER
  MASTER_USER
}

enum ReportStatus {
  DRAFT
  PENDING_APPROVAL
  NEEDS_REVISION
  APPROVED
}

enum TaskStatus {
  PENDING
  COMPLETED
}

model User {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String   @unique
  password  String
  role      Role     @default(CONTRACTS)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdTasks  ToDoTask[] @relation("TaskCreator")
  assignedTasks ToDoTask[] @relation("TaskAssignee")

  extraWorkReports ExtraWorkReport[]
}

model ToDoTask {
  id      String     @id @default(cuid())
  task    String
  duedate DateTime
  status  TaskStatus @default(PENDING)

  jobId       String?
  job         Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User    @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)

  assignedToId String?
  assignedTo   User?   @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([createdById])
  @@index([assignedToId])
  @@index([status])
}

model Job {
  id        String @id @default(cuid())
  jobNumber String @unique
  jobName   String
  division  String
  year      Int

  extraWorkReports ExtraWorkReport[]
  tasks            ToDoTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([division])
  @@index([year])
  @@index([division, year])
}

model ExtraWorkReport {
  id          String       @id @default(cuid())
  jobId       String?
  job         Job?         @relation(fields: [jobId], references: [id], onDelete: Restrict)
  ewrNumber   String       @unique
  workDate    DateTime
  recipent    String?
  description String
  status      ReportStatus @default(DRAFT)

  labourEntries    EWRLabourRow[]
  equipmentEntries EWREquipmentRow[]
  materialEntries  EWRMaterialRow[]
  invoices         EWRInvoiceRow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]

  @@index([jobId])
  @@index([status])
  @@index([workDate])
}

model LabourRate {
  id             String   @id @default(cuid())
  employeeNumber Int      @unique
  baseWorkClass  String
  baseClassName  String
  rate           Decimal  @db.Decimal(10, 2)
  saturdayRate   Decimal  @db.Decimal(10, 2)
  sundayRate     Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([baseWorkClass])
  @@index([baseClassName])
}

model EquipmentRate {
  id              String   @id @default(cuid())
  equipmentNumber String   @unique
  makeModelYear   String
  description     String
  equipmentRate   Decimal  @db.Decimal(10, 2)
  horsePower      Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([description])
}

model MaterialRate {
  id           String @id @default(cuid())
  materialType String
  materialUnit String

  @@unique([materialType, materialUnit])
  @@index([materialType])
}

model Invoice {
  id            String      @id @default(cuid())
  invoiceType   String
  invoiceAmount Float
  invoiceMarkup Float
  attachment    Attachment? @relation(fields: [attachmentId], references: [id])
  attachmentId  String?
}

model Attachment {
  id       String @id @default(cuid())
  fileName String
  fileType String
  fileSize Int?
  fileUrl  String

  reportID   String
  uploadedAt DateTime      @default(now())
  invoiceId  String        @unique
  invoice    EWRInvoiceRow @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  invoices Invoice[]
}

model EWRLabourRow {
  id             String  @id @default(cuid())
  employeeNumber Int?
  classification String
  hours          Float
  Rate           Decimal @db.Decimal(10, 2)
  Amount         Decimal @db.Decimal(10, 2)

  reportId  String
  report    ExtraWorkReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@index([reportId])
}

model EWREquipmentRow {
  id         String  @id @default(cuid())
  name       String
  unitNumber String
  hours      Float
  rate       Decimal @db.Decimal(10, 2)
  amount     Decimal @db.Decimal(10, 2)

  reportId String
  report   ExtraWorkReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([reportId])
}

model EWRMaterialRow {
  id String @id @default(cuid())

  name     String
  unit     String
  quantity Decimal @db.Decimal(10, 2)
  price    Decimal @db.Decimal(10, 2)
  amount   Decimal @db.Decimal(10, 2)

  reportId  String
  report    ExtraWorkReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@index([reportId])
}

model EWRInvoiceRow {
  id String @id @default(cuid())

  name         String
  cost         Decimal @db.Decimal(10, 2)
  markup       Float
  attachmentId String?

  attachment Attachment?
  reportId   String
  report     ExtraWorkReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([reportId])
}
